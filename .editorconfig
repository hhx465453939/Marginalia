root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Markdown 行尾两个空格是换行语法，不能裁剪
trim_trailing_whitespace = false
indent_size = 2

[*.svg]
indent_size = 2

[*.cmd]
end_of_line = crlf

[bin/marginalia]
end_of_line = lf
